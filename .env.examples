APP_NAME=Mini-RAG
APP_VERSION=0.1.0
OPENAI_API_KEY=
FILE_ALLOWED_TYPES=[".pdf",".txt",".docx"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000
MONGODB_DATABASE=mini_rag
MONGODB_URI=mongodb://localhost:27007

# LLM provider configuration (OpenRouter adapter credentials included)
OPENROUTER_API_KEY=
CHAT_PROVIDER=openrouter
CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=60
LLM_TEST_ENDPOINTS_ENABLED=false

# Vector database configuration. One collection per embedding model; each
# collection defines its own vector dimension and distance metric.
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_COLLECTIONS=[{"name":"document_chunks_nemotron_1b","dimension":2048,"distance":"cosine"},{"name":"document_chunks_lfm_350m","dimension":1024,"distance":"cosine"}]
# Optional. Must match one of VECTOR_DB_COLLECTIONS. When omitted, the first
# configured collection is used. It must match the configured embedding model.
VECTOR_DB_COLLECTION=document_chunks_nemotron_1b
# Qdrant is exposed by docker/docker-compose.yml. Keep this URL when FastAPI
# runs directly on the host or from WSL.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30

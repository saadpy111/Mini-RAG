# Mini-RAG environment template - this is the only env file in the repository.
# Copy this file to .env at the repository root, then replace every
# placeholder. The real .env file is Git-ignored and must never be committed.
# Every service (FastAPI settings, Docker Compose interpolation, and the API
# container env_file) reads the root .env file. Do not create .env files in
# subdirectories such as docker/.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Mini-RAG
APP_VERSION=0.1.0
OPENAI_API_KEY=
FILE_ALLOWED_TYPES=[".pdf",".txt",".docx"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000

MONGODB_DATABASE=mini_rag
# Used only when FastAPI runs directly on the host. Docker Compose overrides
# this with an authenticated connection to the mongodb service
# (mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@mongodb:27017).
MONGODB_URI=mongodb://minirag_admin:replace-with-a-strong-password@localhost:27007/?authSource=admin

# ---------------------------------------------------------------------------
# LLM provider configuration (OpenRouter adapter credentials included)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
CHAT_PROVIDER=openrouter
CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=60
LLM_TEST_ENDPOINTS_ENABLED=false

# ---------------------------------------------------------------------------
# Vector database configuration. One collection per embedding model; each
# collection defines its own vector dimension and distance metric.
# ---------------------------------------------------------------------------
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_COLLECTIONS=[{"name":"document_chunks_nemotron_1b","dimension":2048,"distance":"cosine"},{"name":"document_chunks_lfm_350m","dimension":1024,"distance":"cosine"}]
# Optional. Must match one of VECTOR_DB_COLLECTIONS. When omitted, the first
# configured collection is used. It must match the configured embedding model.
VECTOR_DB_COLLECTION=document_chunks_nemotron_1b
# Used when FastAPI runs directly on the host. Docker Compose overrides this
# with http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30

# ---------------------------------------------------------------------------
# Docker Compose infrastructure credentials
# Replace these placeholders before the first start. MongoDB initialization
# only uses these values when its data directory is empty. Compose derives the
# internal MongoDB URL from MONGO_ROOT_*, so no extra docker/.env is required.
# ---------------------------------------------------------------------------
MONGO_ROOT_USERNAME=minirag_admin
MONGO_ROOT_PASSWORD=replace-with-a-strong-password
MONGO_EXPRESS_USERNAME=minirag
MONGO_EXPRESS_PASSWORD=replace-with-a-strong-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# ---------------------------------------------------------------------------
# Optional host port overrides. Only Nginx binds to all interfaces; every
# administrative UI and direct database port binds to 127.0.0.1.
# ---------------------------------------------------------------------------
NGINX_PORT=8080
MONGO_HOST_PORT=27007
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
MONGO_EXPRESS_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
